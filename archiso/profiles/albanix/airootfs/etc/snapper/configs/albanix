# Snapper config — Albanix OS root subvolume (@)
# Used by snapper-timeline.timer and snapper-cleanup.timer.
# snapshot before every pacman upgrade is handled by snap-pac.

# Subvolume to snapshot.
SUBVOLUME="/"
# Filesystem type.
FSTYPE="btrfs"
# QGroup handling: empty = no qgroup.
QGROUP=""
# Number of timeline snapshots to keep (hourly/daily/weekly/monthly/yearly).
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="10"
TIMELINE_LIMIT_DAILY="10"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_YEARLY="0"
NUMBER_LIMIT="20"
NUMBER_LIMIT_IMPORTANT="4"
ALLOW_USERS=""
BACKGROUND_COMPARISON="yes"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"

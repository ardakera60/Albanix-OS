# PKGBUILD — albanix-kernel (OPTIONAL self-built BORE kernel)
# Self-built path: build a BORE-scheduler kernel locally instead of using
# linux-cachyos-bore from CachyOS repos. Copy linux PKGBUILD from Arch and add
# BORE patches. Config options that matter: CONFIG_SCHED_BORE=y, Thin LTO, ZSTD.
# Runs on the HOST (makepkg).
#
# This is a template; fill in the BORE patch source and adjust pkgver.
pkgbase=albanix-kernel
pkgver=7.1.8
pkgrel=1
pkgdesc="Albanix OS self-built kernel with BORE scheduler"
arch=('x86_64')
url="https://github.com/arda/albanix-os"
license=('GPL-2.0-only')
makedepends=('git' 'make' 'gcc' 'clang' 'llvm' 'lld' 'elfutils' 'python'
             'xmlto' 'kmod' 'inetutils' 'bc' 'libelf')
source=("https://www.kernel.org/pub/linux/kernel/v7.x/linux-${pkgver}.tar.xz")
sha256sums=('SKIP')

export KBUILD_BUILD_HOST=albanix
export KBUILD_BUILD_USER=albanix

build() {
  cd "linux-${pkgver}"
  # Use Albanix kernel config (CONFIG_SCHED_BORE=y, etc.).
  cp "${srcdir}/albanix-kernel.config" .config
  make olddefconfig
  make -j$(nproc)
}

package() {
  cd "linux-${pkgver}"
  make INSTALL_MOD_PATH="${pkgdir}/usr" modules_install
  make INSTALL_DTBS_PATH="${pkgdir}/usr" dtbs_install
  make INSTALL_MOD_PATH="${pkgdir}/usr" headers_install
  install -D -m 0644 arch/x86/boot/bzImage "${pkgdir}/boot/vmlinuz-albanix"
  install -D -m 0644 System.map "${pkgdir}/usr/share/linux-${pkgver}/System.map"
}
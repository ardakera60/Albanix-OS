# PKGBUILD — albanix-theme-blue
# Albanix Blue theme: Plasma look-and-feel org.albanix.blue, color scheme (dark+light),
# SDDM theme, Plymouth theme, bootloader theme entries.
# Runs on the HOST (makepkg).
pkgname=albanix-theme-blue
pkgver=0.1.0
pkgrel=1
pkgdesc="Albanix OS theme — Blue (navy & gold, Kosovo flag motif)"
arch=('any')
url="https://github.com/arda/albanix-os"
license=('GPL-3.0-or-later')
depends=('plasma-workspace' 'sddm' 'plymouth' 'systemd-boot')
source=(
  "org.albanix.blue.metadata.desktop"
  "org.albanix.blue.layout.js"
  "Albanix-Blue-dark.colors"
  "Albanix-Blue-light.colors"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -d "${pkgdir}/usr/share/plasma/look-and-feel/org.albanix.blue/contents"
  install -D -m 0644 "${srcdir}/org.albanix.blue.metadata.desktop" \
    "${pkgdir}/usr/share/plasma/look-and-feel/org.albanix.blue/metadata.desktop"
  install -D -m 0644 "${srcdir}/org.albanix.blue.layout.js" \
    "${pkgdir}/usr/share/plasma/look-and-feel/org.albanix.blue/contents/layout.js"

  install -d "${pkgdir}/usr/share/color-schemes"
  install -D -m 0644 "${srcdir}/Albanix-Blue-dark.colors" \
    "${pkgdir}/usr/share/color-schemes/AlbanixBlue-dark.colors"
  install -D -m 0644 "${srcdir}/Albanix-Blue-light.colors" \
    "${pkgdir}/usr/share/color-schemes/AlbanixBlue-light.colors"

  install -d "${pkgdir}/usr/share/sddm/themes/albanix-blue"
  cp -r "${startdir}/sddm-albanix-blue/." "${pkgdir}/usr/share/sddm/themes/albanix-blue/"

  install -d "${pkgdir}/usr/share/plymouth/themes/albanix-blue"
  cp -r "${startdir}/plymouth-albanix-blue/." "${pkgdir}/usr/share/plymouth/themes/albanix-blue/"
}
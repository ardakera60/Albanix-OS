# packages.x86_64 — Albanix OS live ISO + target system package list
# Runs on the HOST (build machine). archiso installs every package here into
# both the live environment and the installed target system.
#
# Groups:
#   base        — Arch base + kernel + boot tooling
#   kde         — Plasma 6 desktop and core apps
#   network     — NetworkManager, bluez, cups, firewall
#   drivers     — GPU drivers (mesa, nvidia-open, xf86-video-*, firmware)
#   fonts       — Albanian-friendly fonts + emoji
#   apps        — User applications (konsole, dolphin, ark, flatpak, discover…)
#   dev         — Development tools
#   multimedia  — Audio/video codecs and players
#   gaming      — Steam, gaming utilities
#   albanix     — Albanix own packages (branding, keyring, welcome, settings, themes)
#   albanix-perf — CachyOS-inspired performance tooling
#   locale      — Albanian locales, fonts, spellcheck

###############################################################################
# base
###############################################################################
base
base-devel
linux
linux-firmware
linux-lts              # fallback kernel entry on the boot menu
btrfs-progs
dosfstools
efibootmgr
grub                   # BIOS bootloader
grub-btrfs             # bootable Btrfs snapshots (GRUB)
intel-ucode            # Intel CPU microcode
amd-ucode              # AMD CPU microcode
mkinitcpio
systemd-boot           # UEFI bootloader
syslinux               # BIOS boot menu
vim
nano
which
curl
wget
rsync
git
gnupg
openssh

